# Copy this file to .env.local (which git ignores) and fill in the key.
#
# With both values set, the app saves to your Supabase project.
# With either missing, it falls back to demo data kept in this browser.

VITE_SUPABASE_URL=https://cxadzuqjqyzyyqqyvvdy.supabase.co

# Supabase dashboard > Project Settings > API > "anon" "public" key.
# This key is designed to be used in browsers; row-level security protects the data.
# NEVER put the "service_role" key here: it bypasses all security.
VITE_SUPABASE_ANON_KEY=
